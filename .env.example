# Environment Variables Template for RythuBandhu

# FastAPI Backend Configuration
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Database Connection (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Google Gemini AI (Backend only - from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEYS=your-first-gemini-key,your-second-gemini-key,your-third-gemini-key
LLM_MODEL_NAME=gemini-3.7-flash
